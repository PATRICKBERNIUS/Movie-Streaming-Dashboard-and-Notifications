# Copy this file to .streamlit/secrets.toml and fill in real values.
# NEVER commit the real secrets.toml to GitHub — .gitignore already excludes it.
#
# On Streamlit Community Cloud, you don't need this file at all: paste the
# same key/value pairs into your app's Settings -> Secrets panel instead.

WATCHMODE_API_KEY = "paste-your-watchmode-key-here"
GITHUB_TOKEN = "paste-your-fine-grained-personal-access-token-here"
GITHUB_OWNER = "your-github-username"
GITHUB_REPO = "streaming-alert"
MOVIES_PATH = "movies.json"
SERVICES_PATH = "streaming_services.json"

# Optional — enables movie posters in the dashboard. Free key at
# https://www.themoviedb.org/settings/api (no cost, just sign up).
# Leave this line out entirely if you don't want posters.
TMDB_API_KEY = "paste-your-tmdb-key-here"
